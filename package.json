{
  "name": "patchwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "agents",
    "repair",
    "search-certification",
    "platform/api",
    "platform/web",
    "packages/*",
    "replicas/*/api",
    "replicas/*/web"
  ],
  "scripts": {
    "db:create": "node scripts/db-create.mjs",
    "db:migrate": "node scripts/workspace-runner.mjs db:migrate",
    "prisma:generate": "node scripts/workspace-runner.mjs prisma:generate",
    "seed:all": "node scripts/workspace-runner.mjs seed",
    "dev:all": "node scripts/dev-all.mjs",
    "build:all": "node scripts/build-all.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reset:all": "node scripts/workspace-runner.mjs seed",
    "agents:build": "npm run prisma:generate -w @patchwork/agents && npm run build -w @patchwork/agents",
    "agents:test": "npm run test -w @patchwork/agents",
    "agents:db:migrate": "npm run db:migrate -w @patchwork/agents",
    "agents:smoke": "npm run smoke -w @patchwork/agents",
    "agents:run": "npm run run -w @patchwork/agents --",
    "agents:matrix": "npm run matrix -w @patchwork/agents --",
    "research:validate-contracts": "npm run research:validate-contracts -w @patchwork/agents --",
    "research:pilot:db:create": "node scripts/research-pilot-db.mjs create",
    "research:pilot:db:migrate": "node scripts/research-pilot-db.mjs migrate",
    "research:pilot:db:seed": "node scripts/research-pilot-db.mjs seed",
    "research:pilot:db:reset": "node scripts/research-pilot-db.mjs reset",
    "research:pilot": "node scripts/research-pilot-run.mjs pilot",
    "research:pilot:mock": "node scripts/research-pilot-run.mjs pilot --mode mock",
    "research:audit-defects": "node scripts/research-pilot-run.mjs audit-defects",
    "research:pilot:v2:mock": "node scripts/research-pilot-run.mjs pilot --mode mock --manifest experiments/configs/pilot-study-v2.yaml --result-directory experiments/results/pilot-study-v2/mock",
    "research:live:smoke": "node scripts/research-live-smoke.mjs",
    "research:pilot:v2:live": "node scripts/research-live-smoke.mjs --pilot",
    "research:report": "node scripts/research-pilot-run.mjs report",
    "research:resume": "node scripts/research-pilot-run.mjs resume",
    "research:final-eval": "node scripts/final-paper-eval.mjs",
    "research:final-eval:status": "node scripts/final-paper-eval.mjs status",
    "research:final-report": "node scripts/final-paper-eval.mjs report",
    "research:paper:build": "node scripts/final-paper-eval.mjs paper:build",
    "repair:build-graphs": "npm run build-graphs -w @patchwork/repair",
    "repair:validate-graphs": "npm run validate-graphs -w @patchwork/repair",
    "repair:audit-localization": "npm run audit-localization -w @patchwork/repair",
    "repair:generate": "npm run generate -w @patchwork/repair",
    "repair:validate": "npm run validate -w @patchwork/repair",
    "repair:replay": "npm run replay -w @patchwork/repair",
    "repair:pilot": "npm run pilot -w @patchwork/repair",
    "repair:sandbox:test": "npm run sandbox:test -w @patchwork/repair --",
    "repair:replay:runtime": "npm run replay:runtime -w @patchwork/repair --",
    "repair:regression": "npm run regression -w @patchwork/repair --",
    "repair:rollback:runtime": "npm run rollback:runtime -w @patchwork/repair --",
    "repair:pilot:runtime": "npm run pilot:runtime -w @patchwork/repair --",
    "repair:resume": "npm run resume -w @patchwork/repair --",
    "search:build-space": "node scripts/search-certification-run.mjs build-space",
    "search:validate-space": "node scripts/search-certification-run.mjs validate-space",
    "search:oracle": "node scripts/search-certification-run.mjs oracle",
    "search:oracle:resume": "node scripts/search-certification-run.mjs oracle --resume",
    "search:run": "node scripts/search-certification-run.mjs search",
    "search:resume": "node scripts/search-certification-run.mjs search --resume",
    "confirmation:run": "node scripts/search-certification-run.mjs confirmation",
    "confirmation:resume": "node scripts/search-certification-run.mjs confirmation --resume",
    "search:v2:audit-search": "node scripts/search-certification-run.mjs v2:audit-search",
    "search:v2:confirmation": "node scripts/search-certification-run.mjs v2:confirmation",
    "search:v2:pilot": "node scripts/search-certification-run.mjs v2:pilot",
    "confirmation:v2:full": "node scripts/search-certification-run.mjs confirmation:v2:full",
    "confirmation:v2:resume": "node scripts/search-certification-run.mjs confirmation:v2:resume",
    "confirmation:v2:status": "node scripts/search-certification-run.mjs confirmation:v2:status",
    "confirmation:v2:report": "node scripts/search-certification-run.mjs confirmation:v2:report",
    "confirmation:v2:audit-support": "node scripts/search-certification-run.mjs confirmation:v2:audit-support",
    "platform:install": "npm install",
    "platform:db:migrate": "npm run db:migrate -w @patchwork/platform-api",
    "platform:seed": "npm run seed -w @patchwork/platform-api",
    "platform:setup": "npm run db:create && npm run platform:db:migrate && npm run platform:seed",
    "platform:dev": "node scripts/dev-platform.mjs",
    "platform:build": "npm run build -w @patchwork/platform-api && npm run build -w @patchwork/platform-web",
    "platform:test": "npm run test -w @patchwork/platform-api && npm run test -w @patchwork/platform-web",
    "platform:test:e2e": "npm run test:e2e -w @patchwork/platform-web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.83.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.6.1",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "playwright": "^1.54.1",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
