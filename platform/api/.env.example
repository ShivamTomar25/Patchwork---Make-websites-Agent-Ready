DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/patchwork_platform
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
APP_ENV=development
DEBUG=false
WEB_URL=http://localhost:3200
API_URL=http://localhost:4200
API_PORT=4200
# Hosted deployment uses APP_ENV=production, an HTTPS WEB_URL and a random
# JWT_SECRET_KEY (32+ characters). Render supplies PORT and RENDER_EXTERNAL_URL.
# Configure PATCHWORK_INTERNAL_AGENT_TOKEN privately for an external runner.
